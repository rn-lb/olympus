# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Comma-separated channel IDs. Leave empty to disable automatic translation.
AUTO_TRANSLATE_CHANNEL_IDS=

# LibreTranslate-compatible endpoint. Self-hosting is recommended for reliability.
TRANSLATE_API_URL=http://localhost:5000
TRANSLATE_API_KEY=

# Prevent oversized requests and noisy output.
MAX_SOURCE_LENGTH=1500
TRANSLATION_COOLDOWN_MS=3000
